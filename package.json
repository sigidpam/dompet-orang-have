{
  "name": "dompet-orang-have",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first, encrypted personal wealth and cashflow PWA",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "audit:sca": "npm audit --audit-level=high",
    "audit:sca:prod": "npm audit --omit=dev --audit-level=high",
    "scan:sast": "semgrep scan --config=p/default --config=p/typescript --config=p/javascript --config=p/secrets --metrics=off --error --exclude=node_modules --exclude=dist --exclude=coverage --exclude=legacy",
    "scan:bandit": "bandit -q -r legacy/api",
    "scan:secrets": "node scripts/scan-secrets.mjs"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "idb": "8.0.4",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-security": "4.2.1",
    "fake-indexeddb": "6.2.7",
    "globals": "17.14.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "workbox-window": "7.4.1"
  }
}
